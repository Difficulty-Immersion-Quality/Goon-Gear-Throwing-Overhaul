-- Basic Poison
function BPoisThrow(item)
    item = item or context.HitDescription.ThrownObject
    return IsHit() & HasAnyStatus({ 'POISON_SIMPLE_DIPPED' }, {}, {}, item)
end

-- Drow Poison
function DPoisThrow(item)
    item = item or context.HitDescription.ThrownObject
    return IsHit() & HasAnyStatus({ 'POISON_DROW_DIPPED' }, {}, {}, item)
end

-- Crawler Mucus - Also covers "Karabasan's Poison"
function CMPoisThrow(item)
    item = item or context.HitDescription.ThrownObject
    return IsHit() & HasAnyStatus({ 'POISON_CRAWLER_MUCUS_DIPPED' }, {}, {}, item)
end

-- Malice
function MPoisThrow(item)
