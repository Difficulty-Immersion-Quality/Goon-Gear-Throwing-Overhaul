function SlingShoesThrow(item)
    item = item or context.HitDescription.ThrownObject
    return IsHit() & HasAnyStatus({ 'MAG_PROJECTILE_SHOES_TECHNICAL', 'GOON_SLINGINGSHOES_ARMOUR_TECHNICAL' }, {}, {}, item)
end

