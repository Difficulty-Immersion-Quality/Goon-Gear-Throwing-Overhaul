-- ==================================== Core vanilla function overwrites ====================================
-- Call custom functions that handle edge cases for attack type conditions, in Goon's Library.
-- Worst case scenario with this broad implementation of shoving edge cases in to everything, is that there might be a few cases of getting multiple triggers from things with a lot of IF.
-- TODO: Goon_IsThrownWeaponAttack() being implemented the way it is here inspires a change in the way I do tooltips when adding throwing support. 
-- Could make a passive and link to it explaining the "thrown weapon attack". Stuff would read like "when you deal damage with a thrown weapon attack", to distinguish from throwing anything.
-- Previous stuff has read like "Melee and &lt;LSTag Type="Spell" Tooltip="Throw_Throw"&gt;thrown&lt;/LSTag&gt; &lt;LSTag Tooltip="AttackRoll"&gt;Attacks&lt;/LSTag&gt; using melee weapons deal an additional [1]." which is actually just awful. Replace that wherever I've checked for HasWeaponProperty(WeaponProperties.Melee, context.HitDescription.ThrownObject).

function IsAttack()
    -- return IsMeleeAttack() | IsRangedAttack()
    return IsMeleeAttack() | IsRangedAttack() | IsWeaponAttack()
end

function IsWeaponAttack()
    -- result = context.HitDescription.AttackType == AttackType.RangedWeaponAttack
    local result = context.HitDescription.AttackType == AttackType.RangedWeaponAttack
                or context.HitDescription.AttackType == AttackType.MeleeWeaponAttack
                or context.HitDescription.AttackType == AttackType.RangedOffHandWeaponAttack
                or context.HitDescription.AttackType == AttackType.MeleeOffHandWeaponAttack
    -- return ConditionResult(result)
    return ConditionResult(result) | IsMainHandWeaponAttack() | IsOffHandAttack() | Goon_IsThrownWeaponAttack()
end

function IsWeaponAttackAttackDescription()
    -- result = context.AttackDescription.AttackType == AttackType.RangedWeaponAttack
    local result = context.AttackDescription.AttackType == AttackType.RangedWeaponAttack
                or context.AttackDescription.AttackType == AttackType.MeleeWeaponAttack
                or context.AttackDescription.AttackType == AttackType.RangedOffHandWeaponAttack
                or context.AttackDescription.AttackType == AttackType.MeleeOffHandWeaponAttack
    -- return ConditionResult(result)
    return ConditionResult(result) | IsMainHandWeaponAttack() | IsOffHandAttack() | Goon_IsThrownWeaponAttack()
end

function IsMainHandWeaponAttack()
    -- result = context.HitDescription.AttackType == AttackType.RangedWeaponAttack 
    local result = context.HitDescription.AttackType == AttackType.RangedWeaponAttack 
                or context.HitDescription.AttackType == AttackType.MeleeWeaponAttack
    -- return ConditionResult(result)
    return ConditionResult(result) | Goon_IsMeleeMainhandWeaponAttack() | Goon_IsRangedMainhandWeaponAttack()
end

function IsOffHandAttack()
    -- result = context.HitDescription.AttackType == AttackType.MeleeOffHandWeaponAttack 
    local result = context.HitDescription.AttackType == AttackType.MeleeOffHandWeaponAttack 
                or context.HitDescription.AttackType == AttackType.RangedOffHandWeaponAttack
    -- return ConditionResult(result)
    return ConditionResult(result) | Goon_IsMeleeOffhandWeaponAttack() | Goon_IsRangedOffhandWeaponAttack()
end

-- function IsSpellAttack()
--     return IsMeleeSpellAttack() | IsRangedSpellAttack()
-- end

-- ==================================== Melee

function IsMeleeAttack()
    -- result = context.HitDescription.AttackType == AttackType.MeleeWeaponAttack 
    local result = context.HitDescription.AttackType == AttackType.MeleeWeaponAttack 
                or context.HitDescription.AttackType == AttackType.MeleeSpellAttack 
                or context.HitDescription.AttackType == AttackType.MeleeUnarmedAttack 
                or context.HitDescription.AttackType == AttackType.MeleeOffHandWeaponAttack
    -- return ConditionResult(result)
    return ConditionResult(result) | IsMeleeWeaponAttack() | IsMeleeUnarmedAttack() | IsMeleeSpellAttack()
end

function IsMeleeWeaponAttack()
    -- result = context.HitDescription.AttackType == AttackType.MeleeWeaponAttack
    local result = context.HitDescription.AttackType == AttackType.MeleeWeaponAttack
                or context.HitDescription.AttackType == AttackType.MeleeOffHandWeaponAttack
    -- return ConditionResult(result)
    return ConditionResult(result) | Goon_IsMeleeMainhandWeaponAttack() | Goon_IsMeleeOffhandWeaponAttack()
end

function IsMeleeUnarmedAttack()
    -- result = context.HitDescription.AttackType == AttackType.MeleeUnarmedAttack
    local result = context.HitDescription.AttackType == AttackType.MeleeUnarmedAttack
    return ConditionResult(result)
end

function IsMeleeSpellAttack()
    -- result = context.HitDescription.AttackType == AttackType.MeleeSpellAttack
    local result = context.HitDescription.AttackType == AttackType.MeleeSpellAttack
    return ConditionResult(result)
end

-- ==================================== Ranged

function IsRangedAttack()
    -- result = context.HitDescription.AttackType == AttackType.RangedWeaponAttack 
    local result = context.HitDescription.AttackType == AttackType.RangedWeaponAttack 
                or context.HitDescription.AttackType == AttackType.RangedSpellAttack 
                or context.HitDescription.AttackType == AttackType.RangedUnarmedAttack 
                or context.HitDescription.AttackType == AttackType.RangedOffHandWeaponAttack
    -- return ConditionResult(result)
    return ConditionResult(result) | IsRangedWeaponAttack() | IsRangedUnarmedAttack() | IsRangedSpellAttack()
end

function IsRangedWeaponAttack()
    -- result = context.HitDescription.AttackType == AttackType.RangedWeaponAttack
    local result = context.HitDescription.AttackType == AttackType.RangedWeaponAttack
                or context.HitDescription.AttackType == AttackType.RangedOffHandWeaponAttack
    -- return ConditionResult(result)
    return ConditionResult(result) | Goon_IsRangedMainhandWeaponAttack() | Goon_IsRangedOffhandWeaponAttack()
end

function IsRangedUnarmedAttack()   
    -- result = context.HitDescription.AttackType == AttackType.RangedUnarmedAttack
    local result = context.HitDescription.AttackType == AttackType.RangedUnarmedAttack
    return ConditionResult(result)
end

function IsRangedSpellAttack()
    -- result = context.HitDescription.AttackType == AttackType.RangedSpellAttack
    local result = context.HitDescription.AttackType == AttackType.RangedSpellAttack
    return ConditionResult(result)
end

-- ==================================== AttackedWithPassiveSourceWeapon expanding
-- Credit to Xiphias Rex: Handle edge cases where spells and actions using a weapon don't have an Attack Roll, but should still function with item passives etc.

function AttackedWithPassiveSourceWeapon()
    local weaponToCheck = nil

    if Goon_IsWeaponActionWithoutAttackRoll().Result then
        weaponToCheck = GetActiveWeapon()
    else
        weaponToCheck = GetAttackWeapon()
    end

    -- result = IsPassiveSource(context.Passive, GetAttackWeapon(), context.Source) | IsPassiveSource(context.Passive, GetAttackWeapon(), GetAttackWeapon()) 
    --        | IsPassiveOwner(context.Passive, GetAttackWeapon(), context.Source)  | IsPassiveOwner(context.Passive, GetAttackWeapon(), GetAttackWeapon())
    -- return result
    return IsPassiveSource(context.Passive, weaponToCheck, context.Source) | IsPassiveSource(context.Passive, weaponToCheck, weaponToCheck) 
         | IsPassiveOwner(context.Passive, weaponToCheck, context.Source)  | IsPassiveOwner(context.Passive, weaponToCheck, weaponToCheck)
end

-- ==================================== Condensed functions ====================================

-- Potent Robe: Gregarious Caster
function Goon_IsConditionalDamageCantripEligible_Greg()
    return Goon_IsConditionalDamageCantripEligible() & ~HasStatus( 'GOON_ONCEPERACTION_COOLDOWN_GREGARIOUSCASTER' , context.Target)
end

-- ==================================== Vanilla throw stuff ====================================

-- ==================================== Thrown property and weight checks

function IsLightThrownObject(entity, checkStacks)
    -- entity = entity or context.Target
    entity = entity or context.HitDescription.ThrownObject
    return ~HasWeaponProperty(WeaponProperties.Thrown,entity) & HasLiftingWeightGreaterThan(500,entity,checkStacks) & ~HasLiftingWeightGreaterThan(10000,entity,checkStacks)
end

function IsMediumThrownObject(entity, checkStacks)
    -- entity = entity or context.Target
    entity = entity or context.HitDescription.ThrownObject
    return ~HasWeaponProperty(WeaponProperties.Thrown,entity) & HasLiftingWeightGreaterThan(10000,entity,checkStacks) & ~HasLiftingWeightGreaterThan(50000,entity,checkStacks)
end

function IsHeavyThrownObject(entity, checkStacks)
    -- entity = entity or context.Target
    entity = entity or context.HitDescription.ThrownObject
    return ~HasWeaponProperty(WeaponProperties.Thrown,entity) & HasLiftingWeightGreaterThan(50000,entity,checkStacks)
end

function Goon_IsLightThrownObjectNotWeapon(item, checkStacks)
    item = item or context.HitDescription.ThrownObject
    return ~(HasWeaponProperty(WeaponProperties.Melee, item) | HasWeaponProperty(WeaponProperties.Thrown, item))
         & HasLiftingWeightGreaterThan(500, item, checkStacks) 
         & ~HasLiftingWeightGreaterThan(10000, item, checkStacks)
end

function Goon_IsMediumThrownObjectNotWeapon(item, checkStacks)
    item = item or context.HitDescription.ThrownObject
    return ~(HasWeaponProperty(WeaponProperties.Melee, item) | HasWeaponProperty(WeaponProperties.Thrown, item))
         & HasLiftingWeightGreaterThan(10000, item, checkStacks) 
         & ~HasLiftingWeightGreaterThan(50000, item, checkStacks)
end

function Goon_IsHeavyThrownObjectNotWeapon(item, checkStacks)
    item = item or context.HitDescription.ThrownObject
    return ~(HasWeaponProperty(WeaponProperties.Melee, item) | HasWeaponProperty(WeaponProperties.Thrown, item))
         & HasLiftingWeightGreaterThan(50000, item, checkStacks)
end

