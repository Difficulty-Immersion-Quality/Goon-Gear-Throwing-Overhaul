-- TODO: Confirm that this actually sets the thrower on fire with non-light objects
function BurnThrow(item)
    item = item or context.HitDescription.ThrownObject
    return IsHit() & HasAnyStatus({ 'BURNING','FLAMING_SPHERE_AURA' }, {}, {}, item) 
         & IsLightThrownObject(item, false)
end

