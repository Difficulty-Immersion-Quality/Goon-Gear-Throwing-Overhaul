-- ==================================== AttackedWithPassiveSourceWeapon expanding
-- Credit to Xiphias Rex: Handle edge cases where spells and actions using a weapon don't have an Attack Roll, but should still function with item passives etc.

function AttackedWithPassiveSourceWeapon()
    local weaponToCheck = nil

    if Goon_IsWeaponActionWithoutAttackRoll().Result then
        weaponToCheck = GetActiveWeapon()
    else
        weaponToCheck = GetAttackWeapon()
    end

    -- result = IsPassiveSource(context.Passive, GetAttackWeapon(), context.Source) | IsPassiveSource(context.Passive, GetAttackWeapon(), GetAttackWeapon()) 
    --        | IsPassiveOwner(context.Passive, GetAttackWeapon(), context.Source)  | IsPassiveOwner(context.Passive, GetAttackWeapon(), GetAttackWeapon())
    -- return result
    return IsPassiveSource(context.Passive, weaponToCheck, context.Source) | IsPassiveSource(context.Passive, weaponToCheck, weaponToCheck) 
         | IsPassiveOwner(context.Passive, weaponToCheck, context.Source)  | IsPassiveOwner(context.Passive, weaponToCheck, weaponToCheck)
end

-- ==================================== Condensed functions ====================================

-- Potent Robe: Gregarious Caster
function Goon_IsConditionalDamageCantripEligible_Greg()
    return Goon_IsConditionalDamageCantripEligible() & ~HasStatus( 'GOON_ONCEPERACTION_COOLDOWN_GREGARIOUSCASTER' , context.Target)
end

-- ==================================== Vanilla throw stuff ====================================
-- Even if things are made more strict, the weapon itself should always benefit from its own stuff, Thrown property or not.
-- TODO: Check for throwing weapon property for most applications?
-- TODO: Move all this shit to new passives.
-- TODO: Run individual functors for most conditions.

function SlingShoesThrow()
    local item = item or context.HitDescription.ThrownObject
	return IsHit() & HasAnyStatus({ 'MAG_PROJECTILE_SHOES_TECHNICAL', 'GOON_SLINGINGSHOES_ARMOUR_TECHNICAL' }, {}, {}, item)
end

-- Nyrulna
function NyrulnaOnThrow()
    local item = item or context.HitDescription.ThrownObject
	return IsHit() & HasAnyStatus({}, { 'GOON_NYRULNA_WEAPON_TECHNICAL','GOON_NYRULNA_EXPLOSION_TOGGLE_ON' }, {}, item)
end

function NyrulnaOffThrow()
